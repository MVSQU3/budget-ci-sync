# Pooled Neon URL (Vercel Postgres/Neon integration: DATABASE_URL).
# Placeholder only — never commit a real password or host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Direct Neon URL used by Prisma Migrate (Vercel: DATABASE_URL_UNPOOLED).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Server-only pepper mixed into the scrypt hash. 16+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SYNC_PEPPER="replace-with-a-long-random-string"
